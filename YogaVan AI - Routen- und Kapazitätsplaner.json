      "id": "078ba937-b469-48cb-add5-c692f3df387b",
      "name": "Wetterprognose abrufen (Open-Meteo)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        16
      ]
    },
    {
      "parameters": {
        "jsCode": "const standorte = $('CSV zu JSON parsen').all();\nconst wetterDaten = $input.all();\n\nconst kombiniert = standorte.map((item, index) => {\n  const s = item.json;\n  const w = wetterDaten[index]?.json?.daily || {};\n\n  const temps = w.temperature_2m_max || [];\n  const regen = w.precipitation_sum || [];\n  const sonneSek = w.sunshine_duration || [];\n\n  const avgTemp = temps.length\n    ? (temps.reduce((a, b) => a + b, 0) / temps.length).toFixed(1)\n    : 'k.A.';\n  const gesamtRegen = regen.length\n    ? regen.reduce((a, b) => a + b, 0).toFixed(1)\n    : 'k.A.';\n  const avgSonneStd = sonneSek.length\n    ? (sonneSek.reduce((a, b) => a + b, 0) / sonneSek.length / 3600).toFixed(1)\n    : 'k.A.';\n\n  return {\n    region: s.region,\n    ort: s.ort,\n    stellplatz_name: s.stellplatz_name,\n    gespann_geeignet: s.gespann_geeignet,\n    preis_pro_nacht_eur: s.preis_pro_nacht_eur,\n    nachfrage_score_1_bis_10: s.nachfrage_score,\n    besonderheiten: s.besonderheiten,\n    wetter_7_tage: {\n      durchschnitt_max_temp_c: avgTemp,\n      gesamt_niederschlag_mm: gesamtRegen,\n      durchschnitt_sonnenstunden_pro_tag: avgSonneStd,\n      tagesdaten: {\n        datum: w.time || [],\n        temp_max: temps,\n        regen_mm: regen\n      }\n    }\n  };\n});\n\nreturn [\n  {\n    json: {\n      anzahl_standorte: kombiniert.length,\n      standort_analyse_daten: JSON.stringify(kombiniert, null, 2)\n    }\n  }\n];"
      },
      "id": "3976ae0a-f275-43dd-9750-7d1b35eb31a4",
      "name": "Standorte & Wetter zusammenführen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        928,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const antwort = $input.first().json.candidates?.[0]?.content?.parts?.[0]?.text || 'Keine Antwort von der KI erhalten.';\nconst datum = new Date().toLocaleDateString('de-DE');\n\nconst markdownReport = `# 🚐 YogaVan AI – Wöchentlicher Tourenplan (${datum})\\n\\n${antwort}\\n`;\n\nreturn [\n  {\n    json: {\n      report: markdownReport\n    }\n  }\n];"
      },
      "id": "d3a0e79e-9982-44d3-8e89-2a05029b4431",
      "name": "Tourenplan aufbereiten",
