        "jsonBody": "={{\n  JSON.stringify({\n    contents: [\n      {\n        parts: [\n          {\n            text: \"Du bist ein KI-Routenplaner für ein mobiles Yoga-Studio mit Wohnwagen-Gespann. Analysiere die folgenden Standort- und Wetterdaten. Filtere alle Standorte aus, die nicht gespann-geeignet sind, und erstelle einen strukturierten Tourenplan im Markdown-Format mit Begründung pro Stopp.\\n\\nDaten:\\n\" + $json.standort_analyse_daten\n          }\n        ]\n      }\n    ]\n  })\n}}",
